# ==============================================================================
# UniMind Environment Configuration Template (.env.example)
# DO NOT commit real secrets or production keys into this file.
# Copy this file to .env and configure local values before running.
# ==============================================================================

# Core Application Settings
UNIMIND_ENV=development # development | staging | production
UNIMIND_APP_PORT=8000
UNIMIND_APP_HOST=0.0.0.0
UNIMIND_SECRET_KEY=change-this-in-production-use-a-strong-32-char-random-string
UNIMIND_LOG_LEVEL=INFO
UNIMIND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL recommended; sqlite3 supported for local dev/testing)
# Local dev default: sqlite+aiosqlite:///./data/unimind_dev.db
# Production: postgresql+asyncpg://unimind_user:unimind_password@localhost:5432/unimind
DATABASE_URL=sqlite+aiosqlite:///./data/unimind_dev.db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Object Storage (S3 / MinIO)
STORAGE_BACKEND=local # local | s3
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=unimind-documents
S3_REGION=us-east-1

# Redis / Task Queue
REDIS_URL=redis://localhost:6379/0

# Model Provider API Keys (Leave blank if using mock or local providers)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security & Sandboxing
SANDBOX_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
